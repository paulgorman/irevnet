+function AllSubCategories() {
+	global $conn;
+	// every sub-category, keyed by subid. One query per page load, however many callers.
+	static $subs = NULL;
+	if ($subs === NULL) {
+		$subs = array();
+		$result = mysqli_query($conn, "SELECT * FROM `subcategories` ORDER BY `subcategory` ASC");
+		if ($result) {
+			while ($row = mysqli_fetch_array($result, MYSQLI_ASSOC)) {
+				$subs[$row['subid']] = $row;
+			}
+		}
+	}
+	return $subs;
+}
+
+function SubCategoriesOfCategory($cid) {
+	$mine = array();
+	foreach (AllSubCategories() as $subid => $sub) {
+		if ($sub['parent_cid'] == $cid) {
+			$mine[$subid] = $sub;
+		}
+	}
+	return $mine;
+}
+
+function GetSubCategoryByUrl($url, $parent_cid = NULL) {
+	// find a sub-category by its url, optionally insisting on a particular parent category
+	foreach (AllSubCategories() as $sub) {
+		if (strtolower($sub['url']) == strtolower($url) && ($parent_cid === NULL || $sub['parent_cid'] == $parent_cid)) {
+			return $sub;
+		}
+	}
+	return NULL;
+}
+
+function CategoryUrlFromCid($cid) {
+	global $conn;
+	$result = mysqli_query($conn, sprintf("SELECT `url` FROM `categories` WHERE `cid` = '%s'", mysqli_real_escape_string($conn,$cid)));
+	if ($result && mysqli_num_rows($result)) {
+		return strtolower(mysqli_fetch_array($result, MYSQLI_NUM)[0]);
 	}
+	return "";
+}
+
+function NotInSubCategoriesSQL($cid) {
+	global $conn;
+	// SQL fragment: this sample is not in any sub-category of category $cid, so it's listed right in the category itself
+	return sprintf(
+		" AND NOT EXISTS (SELECT 1 FROM `samplesubcategories`
+		   INNER JOIN `subcategories` ON `subcategories`.`subid` = `samplesubcategories`.`subid`
+		   WHERE `samplesubcategories`.`oid` = `samples`.`oid` AND `subcategories`.`parent_cid` = '%s')",
+		mysqli_real_escape_string($conn,$cid)
+	);
 }
 
